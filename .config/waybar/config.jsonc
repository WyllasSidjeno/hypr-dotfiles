{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock",
        "custom/weather"
    ],
    "modules-right": [
        "tray",
        "custom/keychron-mouse",
        "custom/keychron-keyboard",
        "pulseaudio",
        "network",
        "cpu",
        "temperature#cpu",
        "custom/gpu-usage",
        "temperature#gpu",
        "memory",
        "disk#root",
        "disk#home",
        "disk#data",
        "custom/wallpaper-reset",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "<span font_family='Font Awesome 7 Free' font_weight='bold'>\uf111</span>",
            "default": "<span font_family='Font Awesome 7 Free' font_weight='bold'>\uf111</span>"
        },
        "on-click": "activate",
        "sort-by-number": true
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 40,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%H:%M  %y-%m-%d}",
        "format-alt": "{:%A, %d %B %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "custom/weather": {
        "exec": "$HOME/.config/waybar/scripts/weather.sh",
        "interval": 900,
        "return-type": "json"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "custom/keychron-mouse": {
        "exec": "$HOME/.config/waybar/scripts/keychron-mouse-battery.py",
        "interval": 60,
        "return-type": "json",
        "format": "🖱️  {}",
        "signal": 8,
        "on-click": "pkill -RTMIN+8 waybar"
    },

    "custom/keychron-keyboard": {
        "exec": "$HOME/.config/waybar/scripts/keychron-keyboard-battery.py",
        "interval": 60,
        "return-type": "json",
        "format": "⌨️  {}",
        "signal": 9,
        "on-click": "pkill -RTMIN+9 waybar"
    },

    "pulseaudio": {
        "format": "<span font_family='Font Awesome 7 Free' font_weight='bold'>{icon}</span>  {volume:>2}%",
        "format-muted": "<span font_family='Font Awesome 7 Free' font_weight='bold'>\uf026</span>  Muted",
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "<span font_family='Font Awesome 7 Free' font_weight='bold'>\uf1eb</span>  {essid}",
        "format-ethernet": "<span font_family='Font Awesome 7 Free' font_weight='bold'>\uf796</span>  Wired",
        "format-disconnected": "<span font_family='Font Awesome 7 Free' font_weight='bold'>\uf071</span>  Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}"
    },

    "cpu": {
        "format": "<span font_family='Font Awesome 7 Free' font_weight='bold'>\uf2db</span>  {usage:>2}%",
        "interval": 5
    },

    "memory": {
        "format": "<span font_family='Font Awesome 7 Free' font_weight='bold'>\uf538</span>  {used:>4.1f}G",
        "interval": 5
    },

    "temperature#cpu": {
        "hwmon-path": "/sys/class/hwmon/hwmon6/temp1_input",
        "critical-threshold": 85,
        "format": "<span font_family='Font Awesome 7 Free' font_weight='bold'>{icon}</span>  CPU {temperatureC:>2}°C",
        "format-icons": ["\uf2c9"]
    },

    "temperature#gpu": {
        "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
        "critical-threshold": 90,
        "format": "<span font_family='Font Awesome 7 Free' font_weight='bold'>{icon}</span>  GPU {temperatureC:>2}°C",
        "format-icons": ["\uf2c9"]
    },

    "custom/gpu-usage": {
        "exec": "cat /sys/class/drm/card1/device/gpu_busy_percent",
        "interval": 2,
        "format": "<span font_family='Font Awesome 7 Free' font_weight='bold'>\uf2db</span>  GPU {:>2}%"
    },

    "disk#root": {
        "path": "/",
        "interval": 30,
        "format": "<span font_family='Font Awesome 7 Free' font_weight='bold'>\uf0a0</span>  / {percentage_used:>2}%"
    },

    "disk#home": {
        "path": "/home",
        "interval": 30,
        "format": "<span font_family='Font Awesome 7 Free' font_weight='bold'>\uf0a0</span>  Home {percentage_used:>2}%"
    },

    "disk#data": {
        "path": "/mnt/data",
        "interval": 30,
        "format": "<span font_family='Font Awesome 7 Free' font_weight='bold'>\uf0a0</span>  Data {percentage_used:>2}%"
    },

    "custom/wallpaper-reset": {
        "format": "<span font_family='Font Awesome 7 Free' font_weight='bold'></span>",
        "tooltip-format": "Restart hyprpaper",
        "on-click": "$HOME/.config/waybar/scripts/wallpaper-reset.sh"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "shutdown": "shutdown",
            "suspend": "systemctl suspend",
            "hibernate": "systemctl hibernate"
        }
    }
}
